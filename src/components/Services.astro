---
import { services } from '../data/site';
---

<section id="services" class="section-pad bg-paper-alt">
  <div class="container-x">
    <div class="reveal mb-16 max-w-[520px]">
      <p class="label">{services.label}</p>
      <h2 class="heading mt-4">{services.heading}</h2>
      <p class="mt-3 text-[0.9rem] leading-[1.7] text-muted">{services.description}</p>
    </div>

    <ol class="m-0 list-none p-0">
      {services.items.map((item, i) => (
        <li
          class="reveal group grid items-center gap-0 border-t border-accent/15 py-10 last:border-b md:grid-cols-[auto_1fr_auto] md:gap-12"
          style={`--d:${0.08 + i * 0.1}s`}
        >
          <span class="mb-2 font-display text-[1.1rem] italic text-accent-text md:mb-0">
            {String(i + 1).padStart(2, '0')}
          </span>
          <div>
            <h3 class="mb-2 font-display text-[clamp(1.3rem,2.2vw,1.8rem)] font-normal text-ink">
              {item.title}
            </h3>
            <p class="max-w-[480px] text-[0.85rem] leading-[1.7] text-muted">{item.text}</p>
          </div>
          <span
            aria-hidden="true"
            class="hidden size-10 shrink-0 items-center justify-center rounded-full border border-accent/15 transition duration-300 group-hover:border-accent-text group-hover:bg-accent-text md:flex"
          >
            <svg viewBox="0 0 24 24" class="size-4 fill-none stroke-muted stroke-[1.5] transition group-hover:stroke-white">
              <line x1="5" y1="12" x2="19" y2="12"></line>
              <polyline points="12 5 19 12 12 19"></polyline>
            </svg>
          </span>
        </li>
      ))}
    </ol>
  </div>
</section>
