---
import { services } from '../data/site';

// Mỗi dịch vụ có một biểu tượng đường nét riêng, cùng bộ nét để nhất quán.
const icons = [
  // Gia tiên: bông sen
  'M12 21c-4.5-2-7-5.2-7-9 3 .3 5.3 1.7 7 4 1.7-2.3 4-3.7 7-4 0 3.8-2.5 7-7 9zM12 16c-1.6-3-1.6-6.2 0-10 1.6 3.8 1.6 7 0 10z',
  // Decoration: ánh sáng lấp lánh
  'M12 3l1.9 5.1L19 10l-5.1 1.9L12 17l-1.9-5.1L5 10l5.1-1.9L12 3zM19 16l.8 2.2L22 19l-2.2.8L19 22l-.8-2.2L16 19l2.2-.8L19 16z',
  // Planner: lịch có dấu tích
  'M7 3v3M17 3v3M4 9h16M5 5h14a1 1 0 0 1 1 1v13a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V6a1 1 0 0 1 1-1zM9 14.5l2 2 4-4',
];
---

<section id="services" class="section-pad">
  <div class="container-x">
    <div class="reveal mb-12 max-w-[560px] md:mb-16">
      <p class="label">{services.label}</p>
      <h2 class="h-section mt-4">{services.heading}</h2>
      <p class="mt-4 text-ivory/80">{services.description}</p>
    </div>

    <ul class="m-0 grid list-none gap-4 p-0 md:grid-cols-3 md:gap-5">
      {services.items.map((item, i) => (
        <li
          class="glass reveal group relative overflow-hidden rounded-[1.75rem] p-7 transition duration-500 hover:-translate-y-1.5 hover:border-white/30 md:p-8"
          style={`--d:${0.08 + i * 0.12}s`}
        >
          <!-- Vầng sáng mềm hiện lên khi rê chuột -->
          <div class="pointer-events-none absolute -right-16 -top-16 size-48 rounded-full bg-champagne/0 blur-3xl transition duration-700 group-hover:bg-champagne/25"></div>

          <div class="relative mb-10 flex items-center justify-between">
            <span class="flex size-14 items-center justify-center rounded-2xl border border-white/20 bg-white/10">
              <svg viewBox="0 0 24 24" class="size-7 fill-none stroke-champagne stroke-[1.4]" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d={icons[i]}></path>
              </svg>
            </span>
            <span class="text-[0.9rem] font-light tracking-[0.1em] text-ivory/50">{String(i + 1).padStart(2, '0')}</span>
          </div>

          <h3 class="relative mb-3 text-[1.45rem] font-light leading-snug tracking-[-0.01em] text-ivory">{item.title}</h3>
          <p class="relative leading-[1.75] text-ivory/80">{item.text}</p>
        </li>
      ))}
    </ul>
  </div>
</section>
