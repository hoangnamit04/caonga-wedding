---
import { Picture, getImage } from 'astro:assets';
import { gallery } from '../data/site';

// Ảnh phóng to trong lightbox cũng được tối ưu lúc build (rộng 1600px, WebP).
const items = await Promise.all(
  gallery.items.map(async (it) => {
    const big = await getImage({ src: it.src, inferSize: true, width: 1600, format: 'webp' });
    return { ...it, big: big.src };
  }),
);
---

<section id="gallery" class="section-pad">
  <div class="container-x">
    <div class="reveal mx-auto mb-12 max-w-[620px] text-center md:mb-16">
      <p class="label">{gallery.label}</p>
      <h2 class="h-section mt-4">{gallery.heading}</h2>
    </div>

    <!-- Khung kính bao quanh toàn bộ lưới ảnh. Ảnh không bị làm mờ nên cuộn vẫn mượt. -->
    <div class="glass rounded-[2rem] p-2.5 md:p-4">
      <ul class="m-0 grid list-none grid-cols-2 gap-2 p-0 [grid-auto-flow:dense] md:grid-cols-4 md:gap-3">
        {items.map((it, i) => (
          <li class:list={['reveal-scale', it.tall && 'md:row-span-2']} style={`--d:${(i % 4) * 0.08}s`}>
            <button
              type="button"
              data-lightbox-item
              data-full={it.big}
              data-alt={it.alt}
              aria-label={`Phóng to ảnh ${i + 1}`}
              class:list={[
                'group relative block w-full cursor-zoom-in overflow-hidden rounded-2xl bg-white/5',
                it.tall ? 'aspect-square md:aspect-auto md:h-full' : 'aspect-square',
              ]}
            >
              <Picture
                src={it.src}
                alt={it.alt}
                inferSize
                widths={[400, 800]}
                sizes="(min-width: 768px) 24vw, 48vw"
                formats={['avif', 'webp']}
                fallbackFormat="jpeg"
                loading="lazy"
                pictureAttributes={{ class: 'block size-full' }}
                class="size-full object-cover transition-transform duration-700 ease-[var(--ease-luxe)] group-hover:scale-105"
              />
              <span
                aria-hidden="true"
                class="glass-nav absolute bottom-3 right-3 flex size-10 items-center justify-center rounded-full opacity-0 transition duration-300 group-hover:opacity-100 group-focus-visible:opacity-100"
              >
                <svg viewBox="0 0 24 24" class="size-4 fill-none stroke-ivory stroke-[1.6]" stroke-linecap="round">
                  <path d="M15 3h6v6M9 21H3v-6M21 3l-7 7M3 21l7-7"></path>
                </svg>
              </span>
            </button>
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>

<dialog id="lightbox" class="lightbox" aria-label="Xem ảnh phóng to">
  <button type="button" class="lb-btn lb-close" data-lb-close aria-label="Đóng">
    <svg viewBox="0 0 24 24"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
  </button>
  <button type="button" class="lb-btn lb-prev" data-lb-prev aria-label="Ảnh trước">
    <svg viewBox="0 0 24 24"><polyline points="15 18 9 12 15 6"></polyline></svg>
  </button>
  <img id="lbImg" class="lb-img" src="" alt="" />
  <button type="button" class="lb-btn lb-next" data-lb-next aria-label="Ảnh sau">
    <svg viewBox="0 0 24 24"><polyline points="9 6 15 12 9 18"></polyline></svg>
  </button>
  <p id="lbCounter" class="lb-counter" aria-live="polite"></p>
</dialog>

<style>
  .lightbox {
    border: 0;
    padding: 20px;
    width: 100%;
    height: 100%;
    max-width: 100vw;
    max-height: 100dvh;
    background: transparent;
    color: var(--color-ivory);
  }
  .lightbox[open] {
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .lightbox::backdrop {
    background: rgb(15 10 11 / 0.82);
    backdrop-filter: blur(22px) saturate(120%);
    -webkit-backdrop-filter: blur(22px) saturate(120%);
  }
  .lb-img {
    max-width: min(92vw, 1100px);
    max-height: 84dvh;
    width: auto;
    height: auto;
    object-fit: contain;
    border-radius: 1.25rem;
    border: 1px solid rgb(255 255 255 / 0.2);
    box-shadow: 0 30px 90px rgb(0 0 0 / 0.6);
  }
  .lb-btn {
    position: absolute;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 48px;
    height: 48px;
    border-radius: 999px;
    background: rgb(26 18 18 / 0.88);
    border: 1px solid rgb(255 255 255 / 0.22);
    cursor: pointer;
    transition: background 0.3s, transform 0.3s var(--ease-luxe);
  }
  .lb-btn:hover { background: rgb(60 44 44 / 0.95); transform: scale(1.06); }
  .lb-btn svg {
    width: 20px;
    height: 20px;
    stroke: var(--color-ivory);
    stroke-width: 1.6;
    fill: none;
  }
  .lb-close { top: 18px; right: 18px; }
  .lb-prev, .lb-next { top: 50%; margin-top: -24px; }
  .lb-prev { left: 14px; }
  .lb-next { right: 14px; }
  .lb-prev:hover, .lb-next:hover { transform: scale(1.06); }
  .lb-counter {
    position: absolute;
    bottom: 22px;
    left: 50%;
    transform: translateX(-50%);
    margin: 0;
    padding: 6px 16px;
    border-radius: 999px;
    background: rgb(26 18 18 / 0.88);
    border: 1px solid rgb(255 255 255 / 0.18);
    font-size: 0.78rem;
    letter-spacing: 0.14em;
    color: rgb(247 240 230 / 0.85);
  }
</style>

<script>
  const dialog = document.getElementById('lightbox') as HTMLDialogElement;
  const img = document.getElementById('lbImg') as HTMLImageElement;
  const counter = document.getElementById('lbCounter')!;
  const items = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-lightbox-item]'));
  let index = 0;

  const preload = (i: number) => {
    const src = items[(i + items.length) % items.length]?.dataset.full;
    if (src) new Image().src = src;
  };

  function show(i: number) {
    index = (i + items.length) % items.length;
    const item = items[index];
    img.src = item.dataset.full ?? '';
    img.alt = item.dataset.alt ?? '';
    counter.textContent = `${index + 1} / ${items.length}`;
    preload(index + 1);
    preload(index - 1);
  }

  items.forEach((btn, i) =>
    btn.addEventListener('click', () => {
      show(i);
      dialog.showModal();
      document.body.style.overflow = 'hidden';
    }),
  );

  dialog.addEventListener('close', () => {
    document.body.style.overflow = '';
  });
  dialog.addEventListener('click', (e) => {
    if (e.target === dialog) dialog.close();
  });
  dialog.querySelector('[data-lb-close]')!.addEventListener('click', () => dialog.close());
  dialog.querySelector('[data-lb-prev]')!.addEventListener('click', () => show(index - 1));
  dialog.querySelector('[data-lb-next]')!.addEventListener('click', () => show(index + 1));

  document.addEventListener('keydown', (e) => {
    if (!dialog.open) return;
    if (e.key === 'ArrowLeft') show(index - 1);
    if (e.key === 'ArrowRight') show(index + 1);
  });

  // Vuốt ngang trên điện thoại để chuyển ảnh
  let touchX = 0;
  dialog.addEventListener('touchstart', (e) => (touchX = e.changedTouches[0].clientX), { passive: true });
  dialog.addEventListener(
    'touchend',
    (e) => {
      const dx = e.changedTouches[0].clientX - touchX;
      if (Math.abs(dx) > 50) show(index + (dx < 0 ? 1 : -1));
    },
    { passive: true },
  );
</script>
