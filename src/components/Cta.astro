---
import { Picture } from 'astro:assets';
import { cta, site, images, banner } from '../data/site';
---

<section id="contact" class="section-pad">
  <div class="container-x">
    <div class="glass reveal relative overflow-hidden rounded-[2.25rem] p-3 md:p-4">
      <!-- Vầng sáng sau khối kêu gọi để kính có độ sâu -->
      <div class="pointer-events-none absolute -left-24 -top-24 size-96 rounded-full bg-champagne/20 blur-3xl"></div>
      <div class="pointer-events-none absolute -bottom-28 right-1/3 size-96 rounded-full bg-rose/20 blur-3xl"></div>

      <div class="relative grid items-center gap-6 md:grid-cols-12 md:gap-10">
        <div class="px-4 pb-2 pt-8 md:col-span-7 md:py-10 md:pl-12 md:pr-0">
          <p class="label">{cta.label}</p>
          <h2 class="h-section mb-5 mt-4">{cta.heading}</h2>
          <p class="mb-9 max-w-[480px] leading-[1.75] text-ivory/80">{cta.text}</p>

          <div class="flex flex-wrap gap-3">
            <a href={`tel:${site.phone}`} class="btn btn-primary">Gọi ngay {site.phoneDisplay}</a>
            <a href={site.zalo} target="_blank" rel="noopener noreferrer" class="btn btn-glass">Nhắn Zalo</a>
          </div>
        </div>

        <div class="md:col-span-5">
          <Picture
            src={images.banner}
            alt={banner.alt}
            inferSize
            widths={[400, 640, 900]}
            sizes="(min-width: 768px) 36vw, 92vw"
            formats={['avif', 'webp']}
            fallbackFormat="jpeg"
            loading="lazy"
            pictureAttributes={{ class: 'block' }}
            class="aspect-[4/5] w-full rounded-[1.75rem] object-cover md:aspect-[5/6]"
          />
        </div>
      </div>
    </div>
  </div>
</section>
