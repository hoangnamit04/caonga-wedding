---
import { Picture } from 'astro:assets';
import { testimonial, images } from '../data/site';
---

<section id="reviews" class="section-pad">
  <div class="container-x">
    <div class="grid items-stretch gap-4 md:grid-cols-12 md:gap-5">
      <div class="reveal-left md:col-span-4">
        <div class="glass h-full rounded-[2rem] p-2.5">
          <Picture
            src={images.testimonial}
            alt={testimonial.alt}
            inferSize
            widths={[400, 640, 900]}
            sizes="(min-width: 768px) 30vw, 92vw"
            formats={['avif', 'webp']}
            fallbackFormat="jpeg"
            loading="lazy"
            pictureAttributes={{ class: 'block h-full' }}
            class="aspect-[4/5] size-full rounded-[1.5rem] object-cover md:aspect-auto"
          />
        </div>
      </div>

      <figure class="glass reveal-right relative m-0 flex flex-col justify-center overflow-hidden rounded-[2rem] p-8 md:col-span-8 md:p-14">
        <div class="pointer-events-none absolute -right-24 -top-24 size-72 rounded-full bg-rose/15 blur-3xl"></div>
        <p class="label relative mb-6">Khách hàng nói gì</p>
        <div aria-hidden="true" class="relative mb-2 text-[4rem] font-light leading-none text-champagne/70">&ldquo;</div>
        <blockquote class="relative m-0 mb-8 text-[clamp(1.2rem,2.3vw,1.7rem)] font-light leading-[1.6] tracking-[-0.01em] text-ivory">
          {testimonial.quote}
        </blockquote>
        <figcaption class="relative border-t border-white/15 pt-5">
          <p class="mb-0.5 font-medium text-ivory">{testimonial.name}</p>
          <p class="text-[0.78rem] uppercase tracking-[0.12em] text-champagne">{testimonial.detail}</p>
        </figcaption>
      </figure>
    </div>
  </div>
</section>
