---
import { site } from '../data/site';

const links = [
  { href: '#about', label: 'Về Chúng Tôi' },
  { href: '#services', label: 'Dịch Vụ' },
  { href: '#gallery', label: 'Gallery' },
];
---

<header class="nav" id="nav">
  <div class="container-x nav__inner">
    <a href="#top" class="nav__logo">{site.name}</a>

    <nav aria-label="Điều hướng chính">
      <ul class="nav__links">
        {links.map((l) => (
          <li><a href={l.href} class="nav__link">{l.label}</a></li>
        ))}
        <li><a href="#contact" class="nav__cta">Liên Hệ</a></li>
      </ul>
    </nav>

    <button
      class="nav__toggle"
      id="navToggle"
      type="button"
      aria-label="Mở menu"
      aria-expanded="false"
      aria-controls="mobileMenu"
    >
      <span></span><span></span><span></span>
    </button>
  </div>
</header>

<div class="mobile-menu" id="mobileMenu">
  {links.map((l) => (
    <a href={l.href} class="mobile-menu__link">{l.label}</a>
  ))}
  <a href="#contact" class="mobile-menu__link">Liên Hệ</a>
</div>

<style>
  .nav {
    position: fixed;
    inset: 0 0 auto 0;
    z-index: 1000;
    padding-block: 22px;
    background: transparent;
    transition: all 0.5s var(--ease-luxe);
  }
  .nav.scrolled {
    background: rgb(250 250 250 / 0.95);
    backdrop-filter: blur(24px);
    padding-block: 14px;
    box-shadow: 0 1px 0 rgb(0 0 0 / 0.06);
  }
  .nav__inner {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  .nav__logo {
    font-family: var(--font-display);
    font-size: 1.4rem;
    font-weight: 500;
    letter-spacing: 0.06em;
    color: #fff;
    transition: color 0.5s var(--ease-luxe);
  }
  .nav.scrolled .nav__logo { color: var(--color-ink); }

  .nav__links {
    display: none;
    list-style: none;
    gap: 32px;
    align-items: center;
    margin: 0;
    padding: 0;
  }
  @media (min-width: 768px) {
    .nav__links { display: flex; }
  }
  .nav__link {
    position: relative;
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: rgb(255 255 255 / 0.85);
    transition: color 0.3s;
  }
  .nav.scrolled .nav__link { color: var(--color-muted); }
  .nav__link:hover { color: var(--color-accent-light); }
  .nav.scrolled .nav__link:hover { color: var(--color-accent-text); }
  .nav__link::after {
    content: '';
    position: absolute;
    left: 0;
    bottom: -4px;
    width: 0;
    height: 1px;
    background: currentColor;
    transition: width 0.3s var(--ease-luxe);
  }
  .nav__link:hover::after { width: 100%; }

  .nav__cta {
    font-size: 0.7rem;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    padding: 10px 24px;
    border: 1px solid rgb(255 255 255 / 0.5);
    color: #fff;
    transition: all 0.3s var(--ease-luxe);
  }
  .nav.scrolled .nav__cta {
    border-color: var(--color-accent-text);
    color: var(--color-accent-text);
  }
  .nav__cta:hover {
    background: var(--color-accent-text);
    border-color: var(--color-accent-text);
    color: #fff;
  }

  .nav__toggle {
    display: flex;
    flex-direction: column;
    gap: 5px;
    padding: 10px;
    background: none;
    border: 0;
    cursor: pointer;
  }
  @media (min-width: 768px) {
    .nav__toggle { display: none; }
  }
  .nav__toggle span {
    width: 22px;
    height: 1.5px;
    background: #fff;
    transition: all 0.3s var(--ease-luxe);
  }
  .nav.scrolled .nav__toggle span { background: var(--color-ink); }

  /* Khi menu di động mở: thanh nav trong suốt, biểu tượng và logo màu trắng */
  .nav.menu-open {
    background: transparent;
    backdrop-filter: none;
    box-shadow: none;
  }
  .nav.menu-open .nav__logo { color: #fff; }
  .nav.menu-open .nav__toggle span { background: #fff; }
  .nav.menu-open .nav__toggle span:nth-child(1) { transform: translateY(6.5px) rotate(45deg); }
  .nav.menu-open .nav__toggle span:nth-child(2) { opacity: 0; }
  .nav.menu-open .nav__toggle span:nth-child(3) { transform: translateY(-6.5px) rotate(-45deg); }

  .mobile-menu {
    position: fixed;
    inset: 0;
    z-index: 999;
    background: var(--color-night);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 32px;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.4s var(--ease-luxe), visibility 0s linear 0.4s;
  }
  .mobile-menu.open {
    opacity: 1;
    visibility: visible;
    transition-delay: 0s;
  }
  .mobile-menu__link {
    font-family: var(--font-display);
    font-size: 1.8rem;
    color: rgb(255 255 255 / 0.9);
    transition: color 0.3s;
  }
  .mobile-menu__link:hover { color: var(--color-accent-light); }
</style>

<script>
  const nav = document.getElementById('nav')!;
  const toggle = document.getElementById('navToggle') as HTMLButtonElement;
  const menu = document.getElementById('mobileMenu')!;

  const onScroll = () => nav.classList.toggle('scrolled', window.scrollY > 60);
  onScroll();
  window.addEventListener('scroll', onScroll, { passive: true });

  function setMenu(open: boolean) {
    menu.classList.toggle('open', open);
    nav.classList.toggle('menu-open', open);
    toggle.setAttribute('aria-expanded', String(open));
    toggle.setAttribute('aria-label', open ? 'Đóng menu' : 'Mở menu');
    document.body.style.overflow = open ? 'hidden' : '';
  }

  toggle.addEventListener('click', () => setMenu(!menu.classList.contains('open')));
  menu.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => setMenu(false)));
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') setMenu(false);
  });
</script>
