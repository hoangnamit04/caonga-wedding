---
import { site } from '../data/site';

const links = [
  { href: '#about', label: 'Về chúng tôi' },
  { href: '#services', label: 'Dịch vụ' },
  { href: '#gallery', label: 'Gallery' },
  { href: '#reviews', label: 'Đánh giá' },
];
---

<header class="fixed inset-x-0 top-0 z-[1000] px-3 pt-3 md:px-6 md:pt-5">
  <div class="mx-auto max-w-4xl">
    <div class="glass-nav flex items-center justify-between rounded-full py-2 pl-5 pr-2 md:pl-7 md:pr-2.5">
      <a href="#top" class="text-[1.02rem] font-medium tracking-[0.02em] text-ivory">
        Cao Nga <span class="font-light text-champagne">Wedding</span>
      </a>

      <nav aria-label="Điều hướng chính" class="hidden md:block">
        <ul class="m-0 flex list-none items-center gap-8 p-0">
          {links.map((l) => (
            <li>
              <a href={l.href} class="nav-link text-[0.82rem] text-ivory/80 transition hover:text-champagne">
                {l.label}
              </a>
            </li>
          ))}
        </ul>
      </nav>

      <a href="#contact" class="btn btn-sm btn-primary hidden md:inline-flex">Liên hệ</a>

      <button
        id="navToggle"
        type="button"
        aria-label="Mở menu"
        aria-expanded="false"
        aria-controls="mobileSheet"
        class="flex size-11 items-center justify-center rounded-full bg-white/10 md:hidden"
      >
        <span class="burger" aria-hidden="true"><i></i><i></i></span>
      </button>
    </div>

    <!-- Menu điện thoại: tấm kính thả xuống ngay dưới thanh điều hướng -->
    <div id="mobileSheet" class="sheet glass-nav mt-2 rounded-3xl p-3 md:hidden">
      <ul class="m-0 grid list-none gap-1 p-0">
        {links.map((l) => (
          <li>
            <a href={l.href} class="block rounded-2xl px-4 py-3 text-[1.05rem] text-ivory transition hover:bg-white/10">
              {l.label}
            </a>
          </li>
        ))}
        <li class="pt-2">
          <a href={`tel:${site.phone}`} class="btn btn-primary w-full">Gọi {site.phoneDisplay}</a>
        </li>
      </ul>
    </div>
  </div>
</header>

<style>
  .nav-link { position: relative; }
  .nav-link::after {
    content: '';
    position: absolute;
    left: 0;
    bottom: -5px;
    width: 0;
    height: 1px;
    background: var(--color-champagne);
    transition: width 0.3s var(--ease-luxe);
  }
  .nav-link:hover::after { width: 100%; }

  .burger { position: relative; display: block; width: 18px; height: 10px; }
  .burger i {
    position: absolute;
    left: 0;
    width: 18px;
    height: 1.5px;
    background: var(--color-ivory);
    transition: transform 0.3s var(--ease-luxe), top 0.3s var(--ease-luxe);
  }
  .burger i:nth-child(1) { top: 0; }
  .burger i:nth-child(2) { top: 8.5px; }
  [aria-expanded='true'] .burger i:nth-child(1) { top: 4.2px; transform: rotate(45deg); }
  [aria-expanded='true'] .burger i:nth-child(2) { top: 4.2px; transform: rotate(-45deg); }

  .sheet {
    opacity: 0;
    visibility: hidden;
    transform: translateY(-8px) scale(0.98);
    transform-origin: top center;
    transition: opacity 0.3s var(--ease-luxe), transform 0.3s var(--ease-luxe), visibility 0s linear 0.3s;
  }
  .sheet.open {
    opacity: 1;
    visibility: visible;
    transform: none;
    transition-delay: 0s;
  }
</style>

<script>
  const toggle = document.getElementById('navToggle') as HTMLButtonElement;
  const sheet = document.getElementById('mobileSheet')!;

  function setOpen(open: boolean) {
    sheet.classList.toggle('open', open);
    toggle.setAttribute('aria-expanded', String(open));
    toggle.setAttribute('aria-label', open ? 'Đóng menu' : 'Mở menu');
  }

  toggle.addEventListener('click', () => setOpen(!sheet.classList.contains('open')));
  sheet.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => setOpen(false)));
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') setOpen(false);
  });
  document.addEventListener('click', (e) => {
    if (!sheet.classList.contains('open')) return;
    const target = e.target as Node;
    if (!sheet.contains(target) && !toggle.contains(target)) setOpen(false);
  });
</script>
