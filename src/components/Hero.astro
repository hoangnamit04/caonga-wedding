---
import { Picture } from 'astro:assets';
import { hero, images, site } from '../data/site';
import Stats from './Stats.astro';

const lines = [...hero.lines];
---

<section id="top" class="relative isolate overflow-hidden pb-14 pt-28 md:flex md:min-h-dvh md:items-center md:pb-16 md:pt-32">
  <!-- Ảnh gốc là ảnh dọc, nên dùng làm nền mờ để kính có thứ phía sau để làm mờ.
       Bản nhỏ 480px là đủ vì sẽ bị làm mờ mạnh. -->
  <Picture
    src={images.hero}
    alt=""
    inferSize
    widths={[480]}
    sizes="480px"
    formats={['avif', 'webp']}
    fallbackFormat="jpeg"
    loading="lazy"
    pictureAttributes={{ class: 'absolute inset-0 -z-10 block' }}
    class="size-full scale-125 object-cover opacity-55 blur-3xl"
  />
  <!-- Hai vầng sáng màu đặt sau tấm kính và khung ảnh, để hiệu ứng mờ kính nhìn thấy được -->
  <div class="absolute -left-28 top-[18%] -z-10 size-[26rem] rounded-full bg-rose/45 blur-[90px]"></div>
  <div class="absolute -right-20 top-[30%] -z-10 size-[24rem] rounded-full bg-champagne/30 blur-[90px]"></div>
  <div class="absolute inset-0 -z-10 bg-[radial-gradient(60rem_40rem_at_20%_30%,transparent,var(--color-night)_90%)] opacity-60"></div>
  <div class="absolute inset-x-0 bottom-0 -z-10 h-40 bg-gradient-to-b from-transparent to-night"></div>

  <div class="container-x w-full">
    <div class="grid items-center gap-8 md:grid-cols-12 md:gap-10">
      <div class="md:col-span-7">
        <div class="glass-dark rounded-[2rem] p-7 md:p-12">
          <p class="hero-in label mb-5" style="--d:.1s">{hero.eyebrow}</p>

          <h1 class="h-display mb-6 text-ivory">
            {lines.map((text, i) => (
              <span class="line"><span class="line-inner" style={`--d:${0.2 + i * 0.15}s`}>{text}</span></span>
            ))}
            <span class="line">
              <span class="line-inner text-gradient" style={`--d:${0.2 + lines.length * 0.15}s`}>
                {hero.lastLine.first} &amp; {hero.lastLine.second}
              </span>
            </span>
          </h1>

          <p class="hero-in mb-9 max-w-[470px] text-[1rem] leading-[1.75] text-ivory/80" style="--d:.7s">
            {hero.subtitle}
          </p>

          <div class="hero-in flex flex-wrap gap-3" style="--d:.85s">
            <a href={`tel:${site.phone}`} class="btn btn-primary">Tư vấn miễn phí</a>
            <a href="#gallery" class="btn btn-glass">Xem Gallery</a>
          </div>
        </div>

        <div class="mt-4 md:mt-5">
          <Stats />
        </div>
      </div>

      <!-- Ảnh dọc đặt trong khung kính, đúng tỷ lệ gốc nên không bị cắt hay phóng to -->
      <div class="hero-in mx-auto w-full max-w-[420px] md:col-span-5 md:max-w-none" style="--d:.4s">
        <div class="glass rounded-[2rem] p-2.5 md:p-3">
          <Picture
            src={images.hero}
            alt="Không gian tiệc cưới do Cao Nga Wedding thực hiện"
            inferSize
            widths={[480, 720, 960]}
            sizes="(min-width: 768px) 38vw, 92vw"
            formats={['avif', 'webp']}
            fallbackFormat="jpeg"
            priority
            pictureAttributes={{ class: 'block' }}
            class="aspect-[4/5] w-full rounded-[1.5rem] object-cover"
          />
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  /* Dòng tiêu đề trượt lên. Có đệm trên dưới để dấu thanh tiếng Việt không bị cắt. */
  .line {
    display: block;
    overflow: hidden;
    padding-block: 0.14em;
    margin-block: -0.14em;
  }
  .line-inner {
    display: block;
    opacity: 0;
    transform: translateY(105%);
    animation: line-up 1s var(--ease-luxe) var(--d, 0s) forwards;
  }
  .hero-in {
    opacity: 0;
    animation: fade-up 0.9s var(--ease-luxe) var(--d, 0s) forwards;
  }
  @keyframes line-up {
    to { opacity: 1; transform: translateY(0); }
  }
  @keyframes fade-up {
    from { opacity: 0; transform: translateY(18px); }
    to { opacity: 1; transform: translateY(0); }
  }
  @media (prefers-reduced-motion: reduce) {
    .line-inner,
    .hero-in {
      animation: none;
      opacity: 1;
      transform: none;
    }
  }
</style>
