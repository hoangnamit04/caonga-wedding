---
import { Picture } from 'astro:assets';
import { hero, images, site } from '../data/site';

const lines = [...hero.lines];
---

<section id="top" class="hero relative grid min-h-dvh items-center overflow-hidden md:grid-cols-2">
  <!-- Ảnh hero là ảnh quan trọng nhất của trang: tải sớm, ưu tiên cao, nhiều cỡ -->
  <Picture
    src={images.hero}
    alt=""
    inferSize
    widths={[640, 1024, 1600, 2200]}
    sizes="100vw"
    formats={['avif', 'webp']}
    fallbackFormat="jpeg"
    priority
    pictureAttributes={{ class: 'absolute inset-0 block' }}
    class="size-full object-cover"
  />
  <div class="hero__overlay absolute inset-0"></div>

  <div class="hero__content relative z-10 max-w-[600px] px-6 pb-20 pt-36 md:px-12 md:py-0">
    <p class="hero__eyebrow mb-6 text-[0.68rem] font-medium uppercase tracking-[0.25em] text-accent-light">
      {hero.eyebrow}
    </p>

    <h1 class="hero__title mb-6 font-display text-[clamp(2.4rem,5.5vw,4.2rem)] font-normal leading-[1.15] tracking-[-0.01em] text-white">
      {lines.map((text, i) => (
        <span class="line"><span class="line-inner" style={`--d:${0.3 + i * 0.2}s`}>{text}</span></span>
      ))}
      <span class="line">
        <span class="line-inner" style={`--d:${0.3 + lines.length * 0.2}s`}>
          <em>{hero.lastLine.first}</em> &amp; <em>{hero.lastLine.second}</em>
        </span>
      </span>
    </h1>

    <p class="hero__subtitle mb-10 max-w-[420px] text-[0.9rem] leading-[1.8] text-white/75">
      {hero.subtitle}
    </p>

    <div class="hero__actions flex flex-wrap items-center gap-4">
      <a href={`tel:${site.phone}`} class="btn">Tư Vấn Miễn Phí</a>
      <a
        href="#gallery"
        class="border-b border-white/30 py-[15px] text-[0.7rem] font-medium uppercase tracking-[0.18em] text-white/80 transition hover:border-white hover:text-white"
      >
        Xem Gallery
      </a>
    </div>
  </div>
</section>

<style>
  .hero__overlay {
    background: linear-gradient(
      135deg,
      rgb(26 26 26 / 0.65) 0%,
      rgb(26 26 26 / 0.25) 50%,
      rgb(44 40 37 / 0.5) 100%
    );
  }
  .hero__title em {
    font-style: italic;
    font-weight: 300;
    color: var(--color-accent-light);
  }
  .line { display: block; overflow: hidden; }
  .line-inner {
    display: block;
    opacity: 0;
    transform: translateY(100%);
    animation: line-up 1s var(--ease-luxe) var(--d, 0s) forwards;
  }
  .hero__eyebrow,
  .hero__subtitle,
  .hero__actions {
    opacity: 0;
    animation: fade-up 0.8s var(--ease-luxe) forwards;
  }
  .hero__eyebrow { animation-delay: 0.2s; }
  .hero__subtitle { animation-delay: 0.9s; }
  .hero__actions { animation-delay: 1.1s; }

  @keyframes line-up {
    to { opacity: 1; transform: translateY(0); }
  }
  @keyframes fade-up {
    from { opacity: 0; transform: translateY(16px); }
    to { opacity: 1; transform: translateY(0); }
  }
  @media (prefers-reduced-motion: reduce) {
    .line-inner,
    .hero__eyebrow,
    .hero__subtitle,
    .hero__actions {
      animation: none;
      opacity: 1;
      transform: none;
    }
  }
</style>
