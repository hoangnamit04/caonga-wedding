---
import { site, services } from '../data/site';

const year = new Date().getFullYear();
const socials = [
  {
    name: 'Facebook',
    href: site.facebook,
    path: 'M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z',
    filled: true,
  },
  {
    name: 'Instagram',
    href: site.instagram,
    path: 'M7 2h10a5 5 0 0 1 5 5v10a5 5 0 0 1-5 5H7a5 5 0 0 1-5-5V7a5 5 0 0 1 5-5zm5 6a4 4 0 1 0 0 8 4 4 0 0 0 0-8zm5.5-2.5a1 1 0 1 0 0 2 1 1 0 0 0 0-2z',
    filled: false,
  },
  {
    name: 'TikTok',
    href: site.tiktok,
    path: 'M9 12a4 4 0 1 0 4 4V4a5 5 0 0 0 5 5',
    filled: false,
  },
].filter((s) => s.href);
---

<footer class="bg-ink pb-7 pt-16 text-white/55">
  <div class="container-x">
    <div class="mb-14 grid gap-10 md:grid-cols-[2fr_1fr_1fr]">
      <div>
        <p class="mb-3.5 font-display text-[1.3rem] tracking-[0.06em] text-white">{site.name}</p>
        <p class="max-w-[300px] text-[0.85rem] leading-[1.8]">
          Dịch vụ trang trí tiệc cưới cao cấp và wedding planner chuyên nghiệp tại {site.city}.
        </p>
      </div>

      <div>
        <p class="mb-5 text-[0.68rem] font-medium uppercase tracking-[0.2em] text-accent-light">Dịch Vụ</p>
        <ul class="m-0 flex list-none flex-col gap-2.5 p-0 text-[0.85rem]">
          {services.items.map((s) => (
            <li><a href="#services" class="transition hover:text-accent-light">{s.title}</a></li>
          ))}
        </ul>
      </div>

      <div>
        <p class="mb-5 text-[0.68rem] font-medium uppercase tracking-[0.2em] text-accent-light">Liên Hệ</p>
        <ul class="m-0 flex list-none flex-col gap-2.5 p-0 text-[0.85rem]">
          <li><a href={`tel:${site.phone}`} class="transition hover:text-accent-light">{site.phoneDisplay}</a></li>
          <li>
            <a href={site.zalo} target="_blank" rel="noopener noreferrer" class="transition hover:text-accent-light">Zalo</a>
          </li>
          <li>
            <a href={site.facebook} target="_blank" rel="noopener noreferrer" class="transition hover:text-accent-light">Facebook</a>
          </li>
          <li>{site.city}, Việt Nam</li>
        </ul>
      </div>
    </div>

    <div class="flex flex-col items-center gap-3.5 border-t border-white/10 pt-7 text-center md:flex-row md:justify-between md:text-left">
      <p class="text-[0.75rem]">&copy; {year} {site.name}. All rights reserved.</p>
      <div class="flex gap-3">
        {socials.map((s) => (
          <a
            href={s.href}
            aria-label={s.name}
            target="_blank"
            rel="noopener noreferrer"
            class="flex size-9 items-center justify-center border border-white/15 transition hover:border-accent"
          >
            <svg
              viewBox="0 0 24 24"
              class="size-3.5"
              fill={s.filled ? 'currentColor' : 'none'}
              stroke={s.filled ? 'none' : 'currentColor'}
              stroke-width="1.5"
            >
              <path d={s.path}></path>
            </svg>
          </a>
        ))}
      </div>
    </div>
  </div>
</footer>
