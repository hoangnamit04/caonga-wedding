---
import { site, services } from '../data/site';

const year = new Date().getFullYear();
const socials = [
  {
    name: 'Facebook',
    href: site.facebook,
    path: 'M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z',
    filled: true,
  },
  {
    name: 'Instagram',
    href: site.instagram,
    path: 'M7 2h10a5 5 0 0 1 5 5v10a5 5 0 0 1-5 5H7a5 5 0 0 1-5-5V7a5 5 0 0 1 5-5zm5 6a4 4 0 1 0 0 8 4 4 0 0 0 0-8zm5.5-2.5a1 1 0 1 0 0 2 1 1 0 0 0 0-2z',
    filled: false,
  },
  {
    name: 'TikTok',
    href: site.tiktok,
    path: 'M9 12a4 4 0 1 0 4 4V4a5 5 0 0 0 5 5',
    filled: false,
  },
].filter((s) => s.href);

const linkClass = 'text-ivory/80 transition hover:text-champagne';
---

<!-- Chừa chỗ phía dưới trên điện thoại để thanh liên hệ nhanh không che nội dung -->
<footer class="px-3 pb-28 pt-6 md:px-6 md:pb-8">
  <div class="glass mx-auto max-w-[1200px] rounded-[2rem] px-6 py-10 md:px-12 md:py-14">
    <div class="mb-10 grid gap-10 md:grid-cols-[2fr_1fr_1fr]">
      <div>
        <p class="mb-3 text-[1.3rem] font-medium tracking-[0.02em]">
          Cao Nga <span class="font-light text-champagne">Wedding</span>
        </p>
        <p class="max-w-[320px] leading-[1.8] text-ivory/80">
          Dịch vụ trang trí tiệc cưới cao cấp và wedding planner chuyên nghiệp tại {site.city}.
        </p>
      </div>

      <div>
        <p class="label mb-4">Dịch vụ</p>
        <ul class="m-0 flex list-none flex-col gap-2.5 p-0 text-[0.92rem]">
          {services.items.map((s) => (
            <li><a href="#services" class={linkClass}>{s.title}</a></li>
          ))}
        </ul>
      </div>

      <div>
        <p class="label mb-4">Liên hệ</p>
        <ul class="m-0 flex list-none flex-col gap-2.5 p-0 text-[0.92rem]">
          <li><a href={`tel:${site.phone}`} class={linkClass}>{site.phoneDisplay}</a></li>
          <li><a href={site.zalo} target="_blank" rel="noopener noreferrer" class={linkClass}>Zalo</a></li>
          <li><a href={site.facebook} target="_blank" rel="noopener noreferrer" class={linkClass}>Facebook</a></li>
          <li class="text-ivory/80">{site.city}, Việt Nam</li>
        </ul>
      </div>
    </div>

    <div class="flex flex-col items-center gap-4 border-t border-white/12 pt-6 text-center md:flex-row md:justify-between md:text-left">
      <p class="text-[0.8rem] text-ivory/75">&copy; {year} {site.name}. All rights reserved.</p>
      <div class="flex gap-2.5">
        {socials.map((s) => (
          <a
            href={s.href}
            aria-label={s.name}
            target="_blank"
            rel="noopener noreferrer"
            class="flex size-10 items-center justify-center rounded-full border border-white/20 bg-white/8 text-ivory transition hover:border-champagne hover:text-champagne"
          >
            <svg
              viewBox="0 0 24 24"
              class="size-4"
              fill={s.filled ? 'currentColor' : 'none'}
              stroke={s.filled ? 'none' : 'currentColor'}
              stroke-width="1.6"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d={s.path}></path>
            </svg>
          </a>
        ))}
      </div>
    </div>
  </div>
</footer>
